# Live credentials
ANGEL_ONE_API_KEY=your_live_api_key
ANGEL_ONE_USERNAME=your_live_username
ANGEL_ONE_PIN=your_live_pin
ANGEL_ONE_TOTP_SECRET=your_live_totp_secret
ORDER_FEED_URL=wss://tns.angelone.in/smart-order-update

# Sandbox credentials
ANGEL_ONE_SANDBOX_KEY=your_sandbox_key
ANGEL_ONE_SANDBOX_USERNAME=your_sandbox_username
ANGEL_ONE_SANDBOX_PIN=your_sandbox_pin

# Switch mode (LIVE or SANDBOX)
APP_MODE=SANDBOX

# Frontend shared API auth key
FRONTEND_API_AUTH_KEY=replace_with_a_long_random_key
